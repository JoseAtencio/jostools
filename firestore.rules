rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myUser() {
      return get(/databases/$(database)/documents/jostools/config/users/$(request.auth.uid)).data;
    }

    function myEnterpriseId() {
      return myUser().enterpriseId;
    }

    function isEnterpriseMember(entId) {
      return entId == myEnterpriseId()
        || ('memberships' in myUser() && entId in myUser().memberships);
    }

    match /jostools/config/users/{uid} {
      allow read: if isSignedIn()
        && (request.auth.uid == uid || resource.data.enterpriseId == myEnterpriseId());
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.enterpriseId == null
        && request.resource.data.get('memberships', []) == [];
      allow update: if isSignedIn() && (
        (request.auth.uid == uid && (
          (
            request.resource.data.enterpriseId == resource.data.enterpriseId
            && request.resource.data.get('memberships', []) == resource.data.get('memberships', [])
          )
          || (
            request.resource.data.enterpriseId == null
            && request.resource.data.get('memberships', []) == resource.data.get('memberships', [])
          )
          || (
            request.resource.data.enterpriseId != null
            && get(/databases/$(database)/documents/jostools/config/enterprises/$(request.resource.data.enterpriseId)).data.ownerId == request.auth.uid
            && request.resource.data.memberships.hasAll([request.resource.data.enterpriseId])
            && request.resource.data.memberships.removeAll(resource.data.memberships).hasOnly([request.resource.data.enterpriseId])
          )
          || (
            request.resource.data.joiningCode is string
            && get(/databases/$(database)/documents/jostools/config/invites/$(request.resource.data.joiningCode)).data.used == false
            && getAfter(/databases/$(database)/documents/jostools/config/invites/$(request.resource.data.joiningCode)).data.used == true
            && getAfter(/databases/$(database)/documents/jostools/config/invites/$(request.resource.data.joiningCode)).data.usedBy == request.auth.uid
            && getAfter(/databases/$(database)/documents/jostools/config/invites/$(request.resource.data.joiningCode)).data.enterpriseId == request.resource.data.enterpriseId
            && request.resource.data.memberships.hasAll([request.resource.data.enterpriseId])
            && request.resource.data.memberships.removeAll(resource.data.memberships).hasOnly([request.resource.data.enterpriseId])
          )
          || (
            request.resource.data.enterpriseId != null
            && resource.data.get('memberships', []) is list
            && request.resource.data.enterpriseId in resource.data.get('memberships', [])
            && request.resource.data.memberships.hasAll([request.resource.data.enterpriseId])
            && request.resource.data.memberships.removeAll(resource.data.memberships).hasOnly([request.resource.data.enterpriseId])
          )
        ))
        || (request.auth.uid != uid
            && resource.data.enterpriseId is string
            && get(/databases/$(database)/documents/jostools/config/enterprises/$(resource.data.enterpriseId)).data.ownerId == request.auth.uid
            && request.resource.data.enterpriseId == null
            && request.resource.data.memberships == resource.data.get('memberships', []).removeAll([resource.data.enterpriseId])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["enterpriseId", "memberships"]))
      );
      allow delete: if false;
    }

    match /jostools/config/enterprises/{entId} {
      allow read: if isSignedIn()
        && (resource.data.ownerId == request.auth.uid || isEnterpriseMember(entId));
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }

    match /jostools/config/maintenance_events/{eventId} {
      allow read: if isSignedIn() && resource.data.enterpriseId == myEnterpriseId();
      allow create: if isSignedIn()
        && request.resource.data.enterpriseId == myEnterpriseId();
      allow update, delete: if isSignedIn()
        && resource.data.enterpriseId == myEnterpriseId()
        && request.resource.data.enterpriseId == resource.data.enterpriseId;
    }

    match /jostools/config/categories/{catId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /jostools/config/invites/{code} {
      allow get: if isSignedIn();
      allow list: if isSignedIn()
        && resource.data.enterpriseId == myEnterpriseId()
        && resource.data.createdBy == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.used == false
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.enterpriseId == myEnterpriseId()
        && get(/databases/$(database)/documents/jostools/config/enterprises/$(request.resource.data.enterpriseId)).data.ownerId == request.auth.uid;
      allow update: if isSignedIn()
        && resource.data.used == false
        && request.resource.data.used == true
        && request.resource.data.enterpriseId == resource.data.enterpriseId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.usedBy == request.auth.uid;
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
